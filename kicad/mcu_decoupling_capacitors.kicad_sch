	)
	(text "VDD"
		(exclude_from_sim no)
		(at 133.604 91.694 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "22458f54-9d57-4930-a48f-85a0f84f0115")
	)
	(text "Decoupling Caps.\nGenerally one for each supply pin.\nEach is placed close to its corresponding pin."
		(exclude_from_sim no)
		(at 151.638 77.47 0)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "3b50eb68-1d37-4c06-beab-f73466f22f49")
	)
	(text "Reference board by ST has an extra 100pF cap in parallel,\nbut phil explains this is not necessary since we're going\nto use modern packages that are small enough - such that we\ncan place the 100nF cap close enough to the VDDRF pin. and\nthat in this case the 100pF cap doesn't matter and doesn't\nadd anything."
		(exclude_from_sim no)
		(at 207.264 109.474 0)
		(effects
			(font
				(size 0.508 0.508)
			)
		)
		(uuid "3bd61e14-43e5-4f2f-a415-2c56302292a8")
	)
	(text "phil also explains that paralelling DIFFERENT types\nof capacitors is typically not a good idea, and ty-\npically not necessary. he also explains that it on-\nly makes sense if the package sizes of the compone-\nnts are vastly different."
		(exclude_from_sim no)
		(at 207.518 114.808 0)
		(effects
			(font
				(size 0.508 0.508)
			)
		)
		(uuid "555ddeb6-872a-4e16-bafc-935de3878196")
	)
	(text "Bulk Bypass/Decoupling Cap.\nNext to the package"
		(exclude_from_sim no)
		(at 77.724 100.33 0)
		(effects
			(font
				(size 0.508 0.508)
			)
		)
		(uuid "584bdadd-a94d-4615-b273-95bfde18ea1e")
	)
	(text "Decoupling Capacitors"
		(exclude_from_sim no)
		(at 69.85 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "65a67ecc-637b-4705-aaee-6e509a5d5be4")
	)
	(text "VDDBAT"
		(exclude_from_sim no)
		(at 159.512 91.694 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b6021473-b000-4917-8743-99c4983322cf")
	)
	(text "VDDUSB"
		(exclude_from_sim no)
		(at 95.25 91.948 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d8c3a6eb-0b63-4903-ae5d-3f5cc3ba374c")
	)
	(text "VDDA"
		(exclude_from_sim no)
		(at 109.474 91.948 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "dc16f247-c5f1-4cba-98e0-dcf0c2408213")
	)
	(text "ST says that VDDUSB has a supply voltage range\nof 3.0V to 3.6V, and that it's an external in-\ndependent power supply for USB transceivers.\nAlso, they say it must be connected to VDD or\nGND if unused, but I believe this board uses\nthe USB peripheral so idk why he's connecting\nit to VDD.."
		(exclude_from_sim no)
		(at 99.06 108.204 0)
		(effects
			(font
				(size 0.254 0.254)
			)
		)
		(uuid "f20cb16a-da2a-468c-81b9-83b57f6ee5a2")
	)
	(text "VDDSMPS"
		(exclude_from_sim no)
		(at 177.038 91.694 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f97cb03c-52be-45fb-8553-23f13faa4c19")
	)
