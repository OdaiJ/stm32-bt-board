		(uuid "2f37bd87-7d2d-4a23-92f1-c9c7aeeb5f33")
	)
	(text "Blue LED,\nHas a high V_F. and\n3V3 will let about\n10 mA of current.\nand my STM32\nwon't like that."
		(exclude_from_sim no)
		(at 80.01 87.63 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "33a66487-8af5-40fb-8316-56aa7cf5d336")
	)
	(text "run mode by default.\nbootloader when pressed"
		(exclude_from_sim no)
		(at 167.894 92.202 0)
		(effects
